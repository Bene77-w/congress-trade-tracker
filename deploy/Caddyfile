# HTTPS-Reverse-Proxy vor dem Streamlit-Dashboard.
# Caddy holt und erneuert das Let's-Encrypt-Zertifikat selbst — Voraussetzung
# ist nur, dass der A-Record der Domain auf die Server-IP zeigt.
#
# Die Domain kommt aus der Umgebungsvariable SITE_DOMAIN (deploy/.env), damit
# diese Datei unveraendert bleibt und 'git pull' auf dem Server konfliktfrei
# durchlaeuft.

# Caddys eigene Meldungen (stderr -> 'docker logs'). Bei Proxy-Fehlern, etwa
# einem 502 waehrend eines Neustarts, haengt Caddy den ganzen Request an —
# diese Felder fallen weg, damit das unbegrenzt aufbewahrte Docker-Log keine
# Besucherdaten enthaelt (s. deploy/legal/datenschutz.html, Abschnitt 4).
{
    log default {
        output stderr
        format filter {
            request>remote_ip delete
            request>client_ip delete
            request>remote_port delete
            request>headers delete
            wrap json
        }
    }
}

{$SITE_DOMAIN} {
    encode gzip

    header {
        # Browser merkt sich HTTPS fuer ein Jahr.
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        # Seite darf nicht in fremde Frames eingebettet werden.
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        # Server-Software nicht ausweisen.
        -Server
    }

    # Impressum und Datenschutzerklaerung liefert Caddy selbst aus: erreichbar
    # ohne JavaScript, vor einem aktiven Passwortschutz und auch dann, wenn
    # der Dashboard-Container gerade neu startet. Die persoenlichen Angaben
    # setzt 'templates' aus den LEGAL_*-Variablen ein (deploy/.env).
    @legal path_regexp legal ^/(impressum|datenschutz)/?$
    handle @legal {
        root * /srv/legal
        rewrite * /{re.legal.1}.html
        templates
        file_server
    }

    # Streamlit haelt die Verbindung per WebSocket offen; Caddy leitet
    # Upgrade-Header automatisch weiter, hier ist nichts extra noetig.
    handle {
        reverse_proxy dashboard:8501
    }

    log {
        # Nicht nach /data: dort liegen die Zertifikate. Neue Datei jeden Tag
        # um 00:00 UTC (fester Zeitplan, unabhaengig von Traffic und
        # Neustarts), geloescht 14 Tage nach dem Wechsel; IPs gekuerzt
        # (IPv4 /24, IPv6 /48). Eine Datei umfasst also hoechstens einen Tag,
        # das Aufraeumen laeuft beim naechsten Wechsel — daher nennt die
        # Datenschutzerklaerung "spaetestens nach 16 Tagen".
        output file /var/log/caddy/access.log {
            roll_at 00:00
            roll_keep_for 336h
            roll_keep 15
        }
        format filter {
            request>remote_ip ip_mask 24 48
            request>client_ip ip_mask 24 48
            request>remote_port delete
            request>headers>X-Forwarded-For ip_mask 24 48
            # Header, die IPs oder Sitzungskennungen tragen koennen. Streamlit
            # schickt Wert des XSRF-Cookies und Session-ID im WebSocket-
            # Subprotocol bzw. in X-Xsrftoken.
            request>headers>Forwarded delete
            request>headers>X-Real-Ip delete
            request>headers>Client-Ip delete
            request>headers>Cookie delete
            request>headers>Authorization delete
            request>headers>Sec-Websocket-Protocol delete
            request>headers>X-Xsrftoken delete
            resp_headers>Set-Cookie delete
            wrap console
        }
    }
}
