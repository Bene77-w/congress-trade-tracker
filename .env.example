# Vorlage fuer .env — echte Werte NICHT einchecken (.env ist gitignored).
# Kopieren: cp .env.example .env  und Werte eintragen.

# Anthropic (PDF-Vision-Extractor)
ANTHROPIC_API_KEY=

# Congress.gov API (Vote-Timing / Bills)
CONGRESS_API_KEY=

# OpenFIGI (Ticker-Normalisierung)
OPENFIGI_API_KEY=

# Quiver Quantitative — Auto-Download-Scraper (scrapers/quiver_scraper.py)
# Credential-Login fuer den taeglichen XLSX-Download. 2FA muss deaktiviert sein.
QUIVER_EMAIL=
QUIVER_PASSWORD=

# OpenRouter (Committee Matcher V2)
OPENROUTER_API_KEY=

# --- Oeffentliches Dashboard (deploy/docker-compose.prod.yml) --------------
# Passwortschutz des Dashboards. Default: aus = frei zugaenglich.
APP_AUTH_ENABLED=
APP_PASSWORD=

# 1 = oeffentliche Instanz: Scoring-Presets leben pro Browser-Session im
# Speicher statt in data/config/scoring_presets.json. Lokal leer lassen.
APP_PUBLIC_MODE=

# Kontaktadresse im User-Agent der Datenabrufe (SEC, House, Quiver)
CONTACT_EMAIL=
